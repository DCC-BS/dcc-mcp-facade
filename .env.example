# ---------------------------------------------------------------------------
# Docker socket path for the Traefik Docker provider.
#
# This differs depending on how Docker is installed on the host. Copy this
# file to `.env` and set the correct value for your setup.
#
#   ROOTLESS Docker (no /var/run/docker.sock, daemon per-user):
#     DOCKER_SOCKET=/run/user/<UID>/docker.sock
#
#   ROOTFUL "default" Docker (systemd, socket at standard path):
#     DOCKER_SOCKET=/var/run/docker.sock
#
# Hint: run `docker context ls` to see where your active daemon's socket is,
# or `docker info` and look at the Context / rootless lines.
# ---------------------------------------------------------------------------
DOCKER_SOCKET=/var/run/docker.sock

# Published host port for the Traefik reverse proxy (nginx proxies to this).
# Only needed if you reach Traefik via a host port instead of the docker net.
TRAEFIK_PORT=8001
